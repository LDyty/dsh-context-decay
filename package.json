{
  "name": "dsh-context-decay",
  "version": "0.1.0",
  "private": true,
  "description": "Model-driven, lossy context decay for DeepSeek Harness: inline position anchors, multi-span summaries, explicit drop, tiered re-compression, no recovery.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LDyty/dsh-context-decay.git"
  },
  "homepage": "https://github.com/LDyty/dsh-context-decay#readme",
  "bugs": {
    "url": "https://github.com/LDyty/dsh-context-decay/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "patches",
    "docs/ARCHITECTURE.md",
    "docs/ARCHITECTURE.zh-CN.md",
    "docs/PROMPTS.zh-CN.md",
    "docs/INSTALL.md",
    "docs/INSTALL.zh-CN.md",
    "docs/RELEASE.md",
    "docs/RELEASE.zh-CN.md",
    "docs/GITHUB.md",
    "docs/GITHUB.zh-CN.md",
    "docs/AWESOME.md",
    "docs/AWESOME.zh-CN.md",
    "docs/assets",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "LICENSE.zh-CN.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-client.mjs",
    "build:host": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check": "node scripts/build.mjs --check",
    "check:patch": "node scripts/check-host-patch.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "context-compression",
    "context-decay",
    "compaction",
    "llm",
    "agent"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
